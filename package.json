{
  "name": "basic-slot-pool",
  "private": true,
  "type": "module",
  "scripts": {
    "prestart": "node scripts/write-build-info.mjs",
    "start": "node server.mjs",
    "validate-math": "node node_modules/@kap-solo/suki-engine/tools/validate-math.mjs ./data",
    "generate:books": "node scripts/generate-book-pool.mjs",
    "generate:feature-sample": "node scripts/build-sample-feature-book.mjs",
    "generate:buy": "node scripts/generate-buy-feature-pool.mjs",
    "tune:lookup": "node scripts/tune-lookup.mjs",
    "tune:buy": "node scripts/tune-buy-lookup.mjs",
    "math:buy": "node scripts/generate-buy-feature-pool.mjs && node scripts/tune-buy-lookup.mjs",
    "analyze:math": "node scripts/analyze-math.mjs",
    "math:build": "node scripts/generate-book-pool.mjs && node scripts/generate-tease-pool.mjs && node scripts/generate-feature-pool.mjs && node scripts/tune-lookup.mjs && node scripts/analyze-math.mjs",
    "generate:feature": "node scripts/generate-feature-pool.mjs",
    "generate:tease": "node scripts/generate-tease-pool.mjs",
    "math:publish": "node scripts/publish-math.mjs",
    "prefrontend:publish": "node scripts/write-build-info.mjs",
    "frontend:publish": "node scripts/publish-frontend.mjs",
    "validate:books": "node scripts/validate-cascade-books.mjs",
    "test:smoke": "node node_modules/@kap-solo/suki-engine/harness/smoke.mjs"
  },
  "dependencies": {
    "@esotericsoftware/spine-core": "4.2.74",
    "@esotericsoftware/spine-pixi-v8": "4.2.74",
    "@kap-solo/suki-engine": "github:kap-solo/suki-engine#86a92df",
    "pixi.js": "8.8.1"
  },
  "engines": {
    "node": ">=20"
  }
}
